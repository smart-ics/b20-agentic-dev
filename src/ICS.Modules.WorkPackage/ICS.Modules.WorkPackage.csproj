<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ICS.Core\ICS.Core.csproj" />
    <ProjectReference Include="..\ICS.Modules.Organization\ICS.Modules.Organization.csproj" />
    <ProjectReference Include="..\ICS.Modules.Customer\ICS.Modules.Customer.csproj" />
    <ProjectReference Include="..\ICS.Modules.Product\ICS.Modules.Product.csproj" />
    <ProjectReference Include="..\ICS.Modules.Request\ICS.Modules.Request.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Command handlers, the reference validator, and the repository contract are internal
         implementation details; unit tests exercise them directly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ICS.Tests.Unit</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ICS.Tests.Integration</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
