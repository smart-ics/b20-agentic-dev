<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Architecture §22: Product depends on Cakra.Core, Organization (Read) -->
  <ItemGroup>
    <ProjectReference Include="..\Cakra.Core\Cakra.Core.csproj" />
    <ProjectReference Include="..\Cakra.Modules.Organization\Cakra.Modules.Organization.csproj" />
  </ItemGroup>

  <!-- Architecture §19.3: Dapper data access; §19.2: IModule DI registration -->
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- Architecture §21: Internal repositories are not exposed to other modules, but visible to test suites -->
  <ItemGroup>
    <InternalsVisibleTo Include="Cakra.Tests.Unit" />
    <InternalsVisibleTo Include="Cakra.Tests.Integration" />
  </ItemGroup>

</Project>
