<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Architecture §22: Post depends on Cakra.Core, Domain Events from all modules -->
  <ItemGroup>
    <ProjectReference Include="..\Cakra.Core\Cakra.Core.csproj" />
    <ProjectReference Include="..\Cakra.Modules.Organization\Cakra.Modules.Organization.csproj" />
    <ProjectReference Include="..\Cakra.Modules.Customer\Cakra.Modules.Customer.csproj" />
    <ProjectReference Include="..\Cakra.Modules.Product\Cakra.Modules.Product.csproj" />
    <ProjectReference Include="..\Cakra.Modules.Request\Cakra.Modules.Request.csproj" />
    <ProjectReference Include="..\Cakra.Modules.WorkPackage\Cakra.Modules.WorkPackage.csproj" />
  </ItemGroup>

  <!-- Architecture §19.3: Dapper data access; §19.2: IModule DI registration; §19.7: BackgroundService / IHostedService -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- Architecture §21: Internal repositories are not exposed to other modules, but visible to test suites -->
  <ItemGroup>
    <InternalsVisibleTo Include="Cakra.Tests.Unit" />
    <InternalsVisibleTo Include="Cakra.Tests.Integration" />
  </ItemGroup>

</Project>
